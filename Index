        qtyAA:parseFloat(document.getElementById('qtyAA').value)||0, priceAA:parseFloat(document.getElementById('priceAA').value)||0,
        qtyVIP:parseFloat(document.getElementById('qtyVIP').value)||0, priceVIP:parseFloat(document.getElementById('priceVIP').value)||0,
        qtyJuice:parseInt(document.getElementById('qtyJuice').value)||0,
        qtyChaoNom:parseInt(document.getElementById('qtyChaoNom').value)||0,
        qtyChaoLongan:parseInt(document.getElementById('qtyChaoLongan').value)||0,
        qtyPopia:parseInt(document.getElementById('qtyPopia').value)||0,
        qtyNoodle:parseInt(document.getElementById('qtyNoodle').value)||0,
        customName:document.getElementById('customName').value||'รายการอื่นๆ',
        customPrice:parseFloat(document.getElementById('customPrice').value)||0,
        customQty:parseInt(document.getElementById('customQty').value)||0,
        discount:currentDiscount, totalPrice:total, address:address, payment:p,
        date:new Date().toLocaleDateString('th-TH')
    };
    orders.unshift(newOrder);
    localStorage.setItem('pos_orders', JSON.stringify(orders));
    gasCall('saveOrder',[newOrder], function(){}, function(){});
