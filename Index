function sendChatMessage() {
    var input=document.getElementById('chatInput');
    var msg=input.value.trim();
    if(!msg) return;
    var chatBox=document.getElementById('chatBox');
    chatBox.innerHTML += '<div class="chat-bubble chat-user">'+esc(msg)+'</div>';
    input.value=''; chatBox.scrollTop=chatBox.scrollHeight;
    var typingId='typing-'+Date.now();
    chatBox.innerHTML += '<div id="'+typingId+'" class="chat-bubble chat-ai typing-indicator"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>';
    chatBox.scrollTop=chatBox.scrollHeight;
    setTimeout(function(){
        var el=document.getElementById(typingId); if(el) el.remove();
        var response=generateAIResponse(msg.toLowerCase());
        chatBox.innerHTML += '<div class="chat-bubble chat-ai">'+response+'</div>';
        chatBox.scrollTop=chatBox.scrollHeight;
        playSound('beep');
    }, 800);
}

function generateAIResponse(text) {
    var today=new Date().toLocaleDateString('th-TH');
    var tTotal=0, tExp=0, tCash=0, tTransfer=0, billCount=0;
    orders.forEach(function(o){
        if(o.date===today){ tTotal+=o.totalPrice; billCount++;
            if(o.payment==='เงินสด') tCash+=o.totalPrice; else tTransfer+=o.totalPrice;
        }
    });
    expenses.forEach(function(e){ if(e.date===today) tExp+=e.amount; });
    var net=tTotal-tExp;

    // ====== คำสั่งถามยอดขาย ======
    if(text.indexOf('ยอด')!==-1||text.indexOf('ขาย')!==-1||text.indexOf('รายรับ')!==-1)
        return 'วันนี้ยอดขายรวมทั้งหมด <b>฿'+tTotal.toLocaleString()+'</b> ค่ะ 💰<br><span style="font-size:0.8rem;color:#64748b;">จาก '+billCount+' บิล</span>';

    // ====== คำสั่งถามรายจ่าย ======
    if(text.indexOf('รายจ่าย')!==-1||text.indexOf('จ่าย')!==-1)
        return 'วันนี้รายจ่ายรวม <b>฿'+tExp.toLocaleString()}</b> ค่ะ 💸';

    // ====== คำสั่งถามกำไร ======
    if(text.indexOf('กำไร')!==-1||text.indexOf('สุทธิ')!==-1)
        return 'วันนี้กำไรสุทธิ <b>฿'+net.toLocaleString()+'</b> ค่ะ '+(net>=0?'📈':'📉');

    // ====== คำสั่งถามบิล/ออเดอร์ ======
    if(text.indexOf('บิล')!==-1||text.indexOf('ออเดอร์')!==-1)
        return 'วันนี้รับออเดอร์ <b>'+billCount+' บิล</b> ค่ะ 📦';

    // ====== คำสั่งถามเงินสด ======
    if(text.indexOf('เงินสด')!==-1||text.indexOf('เงินสดคงเหลือ')!==-1)
        return 'รับเงินสดวันนี้ <b>฿'+tCash.toLocaleString()+'</b> โอนเงิน <b>฿'+tTransfer.toLocaleString()+'</b> ค่ะ 💵';

    // ====== คำสั่งถามเมนู/โต๊ะ ======
    if(text.indexOf('เมนู')!==-1||text.indexOf('โต๊ะ')!==-1||text.indexOf('มีอะไรขาย')!==-1||text.indexOf('แนะนำ')!==-1) {
        var reply = '<b>เมนูร้านหวานใจยายชา</b> 🍜<br><br>';
        var currentCat = '';
        MENU_DATA.forEach(function(m){
            if(m.category !== currentCat) {
                currentCat = m.category;
                reply += '<b>🍽 ' + currentCat + '</b><br>';
            }
            reply += '• ' + m.name + ' — <b>' + m.defaultPrice + ' บาท</b> (' + m.unit + ')<br>';
        });
        return reply;
    }

    // ====== ถามชื่อเมนูเฉพาะ ======
    var foundMenu = null;
    MENU_DATA.forEach(function(m){
        if(text.indexOf(m.name.toLowerCase())!==-1) foundMenu = m;
    });
    if(foundMenu) {
        return '<b>'+foundMenu.name+'</b><br>ราคา: <b>'+foundMenu.defaultPrice+' บาท/'+foundMenu.unit+'</b><br>หมวด: '+foundMenu.category+' 😊';
    }

    // ====== สุ่มแนะนำเมนู ======
    if(text.indexOf('สุ่ม')!==-1||text.indexOf('แนะนำอะไร')!==-1||text.indexOf('แนะนำหน่อย')!==-1) {
        var rnd = MENU_DATA[Math.floor(Math.random()*MENU_DATA.length)];
        return 'ลองเมนูนี้สิคะ! 🍀<br><b>'+rnd.name+'</b> — '+rnd.defaultPrice+' บาท ('+rnd.unit+')<br>หมวด: '+rnd.category;
    }

    // ====== ทักทาย ======
    if(text.indexOf('สวัสดี')!==-1||text.indexOf('ดีจ้า')!==-1||text.indexOf('ฮัลโหล')!==-1)
        return 'สวัสดีค่ะ! 👋 วันนี้อยากได้อะไรจากเมนูร้านหวานใจยายชา? ลองพิมพ์:<br>🔹 <i>เมนู</i> ดูเมนูทั้งหมด<br>🔹 <i>ชื่อเมนู</i> เช็คราคาพิเศษ<br>🔹 <i>สุ่ม</i> ให้ AI แนะนำเมนู<br>🔹 <i>ยอดขาย</i> / <i>กำไร</i> / <i>รายจ่าย</i>';

    // ====== ถามราคา ======
    if(text.indexOf('ราคา')!==-1) {
        var reply = 'ราคาเมนูทั้งหมดค่ะ 📋<br><br>';
        MENU_DATA.forEach(function(m){
            reply += '• '+m.name+' — <b>'+m.defaultPrice+' บาท/'+m.unit+'</b><br>';
        });
        return reply;
    }

    // ====== สวัสดี / เขียนอะไรไม่ถูก ======
    return 'ขออภัยค่ะ ฉันยังไม่เข้าใจ 😅 ลองถามเรื่อง:<br>🔹 <i>เมนู</i> ดูรายการอาหาร<br>🔹 <i>ยอดขาย</i> / <i>กำไร</i> / <i>รายจ่าย</i><br>🔹 <i>ชื่อเมนู</i> เช็คราคา เช่น "น้ำลำไย ราคาเท่าไหร่"<br>🔹 <i>สุ่ม</i> แนะนำเมนูให้';
}

