// ================================================================
//  QUANTITY
// ================================================================
function adj(id, delta) {
    playSound('beep');
    var el = document.getElementById(id);
    if (!el) return;
    var val = parseFloat(el.value)||0;
    var step = (id==='qtyA'||id==='qtyAA'||id==='qtyVIP')?0.5:1;
    val += (delta*step);
    if (val<0) val=0;
    if (step===0.5) val = Math.round(val*2)/2;
    else val = Math.round(val);
    el.value = val;
    calcTotal();
}

// ================================================================
//  DISCOUNT
// ================================================================
function applyDiscount() {
    var code = document.getElementById('discountCode').value.trim();
    if (!code) { currentDiscount=0; document.getElementById('discountText').classList.add('hidden'); calcTotal(); return; }
    var parsed = parseInt(code);
    if (isNaN(parsed)) { Swal.fire('ผิดพลาด','กรุณากรอกตัวเลขเท่านั้น','error'); return; }
    currentDiscount = parsed;
    document.getElementById('discountVal').innerText = currentDiscount;
    document.getElementById('discountText').classList.remove('hidden');
    calcTotal();
}

// ================================================================
//  CASH CALC
// ================================================================
function toggleCashCalc() {
    var radios = document.querySelectorAll('input[name="payment"]');
    var p = 'โอนเงิน';
    for (var i=0;i<radios.length;i++) { if(radios[i].checked) { p=radios[i].value; break; } }
    document.getElementById('cashCalcSection').classList.toggle('hidden', p!=='เงินสด');
    if(p==='เงินสด') calcChange();
}
function setReceive(val) {
    var el = document.getElementById('receiveAmount');
    if(val==='exact') el.value = finalNetTotal;
    else el.value = (parseFloat(el.value)||0)+val;
    calcChange();
}
function calcChange() {
    var received = parseFloat(document.getElementById('receiveAmount').value)||0;
    var change = received - finalNetTotal;
    if(change<0||finalNetTotal===0) change=0;
    document.getElementById('changeAmount').innerText = '฿'+change.toLocaleString();
}

// ================================================================
//  CALCULATE TOTAL
// ================================================================
function calcTotal() {
    var total = 0;
    total += (parseFloat(document.getElementById('qtyA').value)||0)*(parseFloat(document.getElementById('priceA').value)||0);
    total += (parseFloat(document.getElementById('qtyAA').value)||0)*(parseFloat(document.getElementById('priceAA').value)||0);
    total += (parseFloat(document.getElementById('qtyVIP').value)||0)*(parseFloat(document.getElementById('priceVIP').value)||0);
    for(var key in fixedPrices) { total += (parseInt(document.getElementById(key).value)||0)*fixedPrices[key]; }
    total += (parseFloat(document.getElementById('customPrice').value)||0)*(parseInt(document.getElementById('customQty').value)||0);
    total -= currentDiscount;
    if(total<0) total=0;
    finalNetTotal = total;
    document.getElementById('displayTotal').innerText = '฿'+total.toLocaleString();
    calcChange();
    return total;
}
var fixedPrices = { qtyJuice:40, qtyChaoNom:40, qtyChaoLongan:50, qtyPopia:60, qtyNoodle:60 };

