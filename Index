    Swal.mixin({toast:true,position:'top',showConfirmButton:false,timer:1500}).fire({icon:'success',title:'บันทึกขายเรียบร้อย'});
}

function resetOrderForm() {
    ['qtyA','qtyAA','qtyVIP','qtyJuice','qtyChaoNom','qtyChaoLongan','qtyPopia','qtyNoodle','customQty']
