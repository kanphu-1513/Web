            let emptyRows = Math.max(3 - items.length, 1); for (let i = 0; i < emptyRows; i++) { tableRows += `<tr><td style="padding: 10px; border-right: 1px solid #000;">&nbsp;</td><td style="border-right: 1px solid #000;"></td><td style="border-right: 1px solid #000;"></td><td></td></tr>`; }
            const netTotal = order.totalPrice; const isCash = order.payment === 'เงินสด' ? '☑' : '☐'; const isTransfer = order.payment === 'โอนเงิน' ? '☑' : '☐';
            const receiptHTML = `<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><title>ใบเสร็จ - ${order.orderNo}</title><link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600&display=swap" rel="stylesheet"><style>body { font-family: 'Sarabun', sans-serif; padding: 10px; color: #000; font-size: 11px; margin: 0; background: #fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; } .paper { max-width: 800px; margin: auto; } table { width: 100%; border-collapse: collapse; } td { vertical-align: top; } @media print { body { padding: 0; } @page { size: A4 portrait; margin: 5mm; } }</style></head><body><div class="paper"><table style="margin-bottom: 10px;"><tr><td style="width: 65%;"><h1 style="margin: 0; font-size: 16px;">หจก. หวานใจยายชา</h1><div style="font-size: 12px; margin-bottom: 5px;">Wanjai Yaicha Ltd., Part.</div><div style="line-height: 1.3;">สำนักงานใหญ่ หมู่บ้านเพฟ รามอินทราวงเเหวนรอบนอก เขตสายไหม กรุงเทพมหานคร 10220<br>Head Office Pave Ramintra Wongwaen, Saimai, Bangkok 10220<br>Tel. 091-902-0620</div></td><td style="width: 35%; text-align: right; vertical-align: top;"><div style="font-size: 14px; font-weight: bold;">ใบเสร็จรับเงิน / ใบกำกับภาษี</div><div>Receipt / Tax Invoice</div></td></tr></table><table style="margin-bottom: 10px; line-height: 1.5;"><tr><td style="width: 15%;">ลูกค้า/Customer :</td><td style="width: 50%;">${order.name}</td><td style="width: 15%;">เลขที่/No. :</td><td style="width: 20%; text-align: right;">${order.orderNo}</td></tr><tr><td>ที่อยู่/Bill To :</td><td>${order.address !== '-' ? order.address : ''}</td><td>วันที่/Date :</td><td style="text-align: right;">${printDate}</td></tr><tr><td>Customer Tax ID :</td><td>-</td><td></td><td></td></tr><tr><td>โทร/Tel :</td><td>${order.phone}</td><td></td><td></td></tr><tr><td>E-Mail :</td><td>-</td><td></td><td></td></tr><tr><td>ส่งสินค้า/Ship To:</td><td>-</td><td></td><td></td></tr><tr><td>Ref. Remark :</td><td>${order.payment}</td><td></td><td></td></tr></table><table style="border: 1px solid #000; margin-bottom: 0;"><thead><tr><th style="width: 50%; border-bottom: 1px solid #000; border-right: 1px solid #000; padding: 5px; font-weight: normal; text-align: center;">รายการสินค้า<br>Description</th><th style="width: 15%; border-bottom: 1px solid #000; border-right: 1px solid #000; padding: 5px; font-weight: normal; text-align: center;">จำนวน<br>Q'ty</th><th style="width: 15%; border-bottom: 1px solid #000; border-right: 1px solid #000; padding: 5px; font-weight: normal; text-align: center;">ราคา/หน่วย<br>Unit Price</th><th style="width: 20%; border-bottom: 1px solid #000; padding: 5px; font-weight: normal; text-align: center;">จำนวนเงิน<br>Amount</th></tr></thead><tbody>${tableRows}</tbody></table><table style="border: 1px solid #000; border-top: none;"><tr><td style="width: 65%; border-right: 1px solid #000; padding: 5px;"><div style="margin-bottom: 5px;">เลขที่ใบแจ้งหนี้/Invoice No : &nbsp;&nbsp; ${order.orderNo}</div><div style="margin-bottom: 3px;">ชำระเงินโดย/Form of Payment</div><table style="width: 100%; margin-bottom: 5px;"><tr><td style="width: 25%;">${isCash} เงินสด/Cash</td><td style="width: 25%;">☐ เช็ค/Cheque</td><td style="width: 30%;">${isTransfer} เงินโอน/Transfer</td><td style="width: 20%;">☐ อื่นๆ</td></tr></table><div>(${THBText(netTotal)})</div></td><td style="width: 35%; padding: 0;"><table style="width: 100%; height: 100%;"><tr><td style="padding: 3px 5px; border-bottom: 1px solid #000; border-right: 1px solid #000;">มูลค่ายกเว้นภาษี/Total Non-Vat</td><td style="padding: 3px 5px; border-bottom: 1px solid #000; text-align: right; width: 60px;">0.00</td></tr><tr><td style="padding: 3px 5px; border-bottom: 1px solid #000; border-right: 1px solid #000;">มูลค่าสินค้าหรือบริการ/Total Vat</td><td style="padding: 3px 5px; border-bottom: 1px solid #000; text-align: right;">${netTotal.toFixed(2)}</td></tr><tr><td style="padding: 3px 5px; border-bottom: 1px solid #000; border-right: 1px solid #000;">ภาษีมูลค่าเพิ่ม/VAT 7 %</td><td style="padding: 3px 5px; border-bottom: 1px solid #000; text-align: right;">0.00</td></tr><tr><td style="padding: 3px 5px; border-right: 1px solid #000;">รวมจำนวนเงินทั้งสิ้น/Grand Total</td><td style="padding: 3px 5px; text-align: right;">${netTotal.toFixed(2)}</td></tr></table></td></tr></table><table style="margin-top: 30px; text-align: center;"><tr><td style="width: 33%;"><div style="border-bottom: 1px solid #000; width: 70%; margin: 0 auto 5px auto;"></div>ผู้รับเงิน/Collector</td><td style="width: 34%;"><div style="border-bottom: 1px solid #000; width: 70%; margin: 0 auto 5px auto;"></div>ผู้ตรวจสอบ/Checked By</td><td style="width: 33%;"><div style="border-bottom: 1px solid #000; width: 70%; margin: 0 auto 5px auto;"></div>ผู้จัดการ/Manager</td></tr></table><table style="margin-top: 20px; width: 100%;"><tr><td style="color: #000;">หมายเหตุ: ใบเสร็จรับเงินนี้จะสมบูรณ์เมื่อมีลายเซ็นผู้จัดการ/ผู้รับเงินของบริษัทและสามารถเรียกเก็บเงินตามเช็คได้แล้ว</td></tr><tr><td style="color: red;">Remark: No receipt will be recognized unless sign by manager/Collector of the company and when the cheque has been collected.<span style="float: right; color: #000;">Page 1 / 1</span></td></tr><tr><td style="text-align: right; padding-top: 5px;">FP-FN-01-02</td></tr></table><div style="font-size: 8px; margin-top: 15px; color: #555;">เอกสารนี้ได้จัดทำและส่งข้อมูลให้แก่กรมสรรพากรด้วยวิธีการทางอิเล็กทรอนิกส์<br>Digitally signed by หจก. หวานใจยายชา<br>Date: ${new Date().toISOString().replace('T',' ').substring(0,19)} GMT+07:00</div></div><script>setTimeout(() => { window.print(); }, 1500);<\/script></body></html>`;
            printWindow.document.write(receiptHTML); printWindow.document.close();
        }
