var audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playSound(type) {
    try {
        if (audioCtx.state === 'suspended') audioCtx.resume();
        var osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        if (type === 'beep') {
            osc.type = 'sine'; osc.frequency.value = 800;
            gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
            osc.start(); osc.stop(audioCtx.currentTime + 0.05);
        } else if (type === 'success') {
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(800, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(1200, audioCtx.currentTime + 0.1);
            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
            osc.start(); osc.stop(audioCtx.currentTime + 0.2);
        }
    } catch(e) {}
}

// ================================================================
//  GAS WRAPPER
// ================================================================
function gasCall(fnName, argsArray, successCb, failCb) {
    if (isGAS) {
        var runner = google.script.run.withSuccessHandler(function(res) {
            if (res && res.success === false) {
                if (res.error === 'Unauthorized') { doLogout(); Swal.fire('Session หมดอายุ','กรุณา Login ใหม่','warning'); }
                else if (failCb) failCb(res);
                return;
            }
            if (successCb) successCb(res);
        });
        if (failCb) runner.withFailureHandler(failCb);
        var callArgs = (argsArray || []).concat([sessionToken]);
        runner[fnName].apply(runner, callArgs);
    } else {
        standaloneHandler(fnName, argsArray, successCb);
    }
}

function standaloneHandler(fnName, args, cb) {
    if (fnName === 'verifyLogin') {
        if (args[0]==='admin' && args[1]==='1234') {
            sessionToken = 'local_'+Date.now();
            localStorage.setItem('pos_session', sessionToken);
            if(cb) cb(sessionToken);
        } else { if(cb) cb(null); }
    } else if (fnName === 'getAllData') {
        var lo = JSON.parse(localStorage.getItem('pos_orders')||'[]');
        var le = JSON.parse(localStorage.getItem('pos_expenses')||'[]');
        if(cb) cb({orders:lo, expenses:le});
    } else if (fnName === 'saveOrder') {
        var a = JSON.parse(localStorage.getItem('pos_orders')||'[]');
        a.unshift(args[0]); localStorage.setItem('pos_orders', JSON.stringify(a));
        if(cb) setTimeout(function(){cb();},100);
    } else if (fnName === 'saveExpense') {
        var ae = JSON.parse(localStorage.getItem('pos_expenses')||'[]');
        ae.unshift(args[0]); localStorage.setItem('pos_expenses', JSON.stringify(ae));
        if(cb) setTimeout(function(){cb();},100);
    } else if (fnName === 'deleteOrderDb') {
        var ao = JSON.parse(localStorage.getItem('pos_orders')||'[]');
        ao = ao.filter(function(o){return o.id!==args[0];});
        localStorage.setItem('pos_orders', JSON.stringify(ao));
        if(cb) setTimeout(function(){cb();},100);
    } else if (fnName === 'deleteExpenseDb') {
        var ae2 = JSON.parse(localStorage.getItem('pos_expenses')||'[]');
        ae2 = ae2.filter(function(e){return e.id!==args[0];});
        localStorage.setItem('pos_expenses', JSON.stringify(ae2));
        if(cb) setTimeout(function(){cb();},100);
    }
}

