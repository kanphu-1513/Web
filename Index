function getItemsArray(order) {
    var items=[];
    if(order.qtyA>0) items.push({name:'ลำไย เกรด A', qty:order.qtyA, price:order.priceA, total:order.qtyA*order.priceA});
    if(order.qtyAA>0) items.push({name:'ลำไย เกรด AA', qty:order.qtyAA, price:order.priceAA, total:order.qtyAA*order.priceAA});
    if(order.qtyVIP>0) items.push({name:'ลำไย เกรด VIP', qty:order.qtyVIP, price:order.priceVIP, total:order.qtyVIP*order.priceVIP});
    if(order.qtyJuice>0) items.push({name:'น้ำลำไย', qty:order.qtyJuice, price:40, total:order.qtyJuice*40});
    if(order.qtyChaoNom>0) items.push({name:'เฉาก๊วยนมสด', qty:order.qtyChaoNom, price:40, total:order.qtyChaoNom*40});
    if(order.qtyChaoLongan>0) items.push({name:'เฉาก๊วยลำไย', qty:order.qtyChaoLongan, price:50, total:order.qtyChaoLongan*50});
    if(order.qtyPopia>0) items.push({name:'ปอเปี๊ยะทอด', qty:order.qtyPopia, price:60, total:order.qtyPopia*60});
    if(order.qtyNoodle>0) items.push({name:'ก๋วยเตี๋ยวลุยสวน', qty:order.qtyNoodle, price:60, total:order.qtyNoodle*60});
    if(order.customQty>0) items.push({name:order.customName||'รายการอื่นๆ', qty:order.customQty, price:order.customPrice, total:order.customQty*order.customPrice});
    return items;
}

// ================================================================
//  GENERATE RECEIPT HTML
// ================================================================
function generateReceiptHTML(order) {
    function THBText(n) {
        var num = Number(n).toFixed(2);
        var txtNum=['ศูนย์','หนึ่ง','สอง','สาม','สี่','ห้า','หก','เจ็ด','แปด','เก้า'];
        var txtUnit=['','สิบ','ร้อย','พัน','หมื่น','แสน','ล้าน'];
        var parts=num.split('.');
        var baht=parts[0], satang=parts[1];

        function convertPart(str) {
            var res='';
            for(var i=0;i<str.length;i++) {
                var d=parseInt(str.charAt(i));
                var p=str.length-i-1;
                if(d!==0) {
                    if(d===1 && p===0 && str.length>1) res+='เอ็ด';
                    else if(d===2 && p===1) res+='ยี่';
                    else if(d===1 && p===1) {}
                    else res+=txtNum[d];
                    res+=txtUnit[p];
                }
            }
            return res;
        }

        if(baht==='0') {
            if(satang==='00') return 'ศูนย์บาทถ้วน';
            return 'ศูนย์บาท '+convertPart(satang)+'สตางค์';
        }

        var t='';
        for(var i=0;i<baht.length;i++) {
            var d=parseInt(baht.charAt(i));
            var p=baht.length-i-1;
            if(d!==0) {
                if(i===baht.length-1 && d===1 && baht.length>1) t+='เอ็ด';
                else if(i===baht.length-2 && d===2) t+='ยี่';
                else if(i===baht.length-2 && d===1) {}
                else t+=txtNum[d];
                t+=txtUnit[p];
            }
        }
        t+='บาท';
        if(satang==='00') t+='ถ้วน';
        else {
            if(satang.charAt(0)==='1' && satang.charAt(1)==='0') t+='สิบ';
