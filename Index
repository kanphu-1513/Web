function deleteItem(id, type) {
    Swal.fire({title:'ลบรายการ?',icon:'warning',showCancelButton:true,confirmButtonColor:'#ef4444'}).then(function(r){
        if(!r.isConfirmed) return;
        if(type==='order'){
            orders = orders.filter(function(o){return o.id!==id;});
            localStorage.setItem('pos_orders', JSON.stringify(orders));
            gasCall('deleteOrderDb',[id], function(){}, function(){});
        } else {
            expenses = expenses.filter(function(e){return e.id!==id;});
            localStorage.setItem('pos_expenses', JSON.stringify(expenses));
            gasCall('deleteExpenseDb',[id], function(){}, function(){});
        }
        renderData();
    });
}

// ================================================================
//  RENDER DATA
// ================================================================
function renderData() {
    var tTotal=0, tCash=0, tTransfer=0, tExp=0;
    var today = new Date().toLocaleDateString('th-TH');
    orders.forEach(function(o){ if(o.date===today){ tTotal+=o.totalPrice; if(o.payment==='เงินสด') tCash+=o.totalPrice; else tTransfer+=o.totalPrice; } });
    expenses.forEach(function(e){ if(e.date===today) tExp+=e.amount; });
    document.getElementById('sumTotal').innerText = '฿'+(tTotal-tExp).toLocaleString();
    document.getElementById('sumTransfer').innerText = '฿'+tTransfer.toLocaleString();
    document.getElementById('sumCash').innerText = '฿'+tCash.toLocaleString();
    document.getElementById('sumExpense').innerText = '฿'+tExp.toLocaleString();
    var list = document.getElementById('dataList');
    var keyword = '';
    var searchInput = document.getElementById('searchHistory');
    if(searchInput) keyword = searchInput.value.toLowerCase();
    var combined = [];
    orders.forEach(function(o){ combined.push({item:o, _type:'order'}); });
    expenses.forEach(function(e){ combined.push({item:e, _type:'exp'}); });
    combined.sort(function(a,b){ return parseInt(b.item.id.replace('EXP',''))-parseInt(a.item.id.replace('EXP','')); });
    if(keyword){
        combined = combined.filter(function(entry){
            var item=entry.item;
            if(entry._type==='order') return item.orderNo.toLowerCase().indexOf(keyword)!==-1||item.name.toLowerCase().indexOf(keyword)!==-1||item.phone.indexOf(keyword)!==-1;
            return item.title.toLowerCase().indexOf(keyword)!==-1;
        });
    }
    if(combined.length===0){ list.innerHTML='<div class="text-center py-8 text-gray-400">ไม่พบข้อมูล</div>'; return; }
    var html='';
    combined.forEach(function(entry){
        var item=entry.item;
        if(entry._type==='order'){
            html += '<div class="p-4 hover:bg-gray-50 transition">' +
                '<div class="flex justify-between items-center mb-1">' +
                '<div class="font-bold text-gray-800">'+esc(item.name)+'</div>' +
                '<div class="font-bold text-emerald-600">+฿'+item.totalPrice.toLocaleString()+'</div></div>' +
                '<div class="flex justify-between items-center text-sm text-gray-500">' +
                '<div>'+item.orderNo+' <span class="bg-gray-100 px-2 py-0.5 rounded text-xs ml-1">'+esc(item.payment)+'</span></div>' +
                '<div class="space-x-3 text-lg">' +
                '<button onclick="printTag(\''+item.id+'\')" class="text-blue-500" title="พิมพ์ใบปะหน้า"><i class="fa-solid fa-box"></i></button>' +
                '<button onclick="printSlip(\''+item.id+'\')" class="text-gray-600" title="พิมพ์สลิป"><i class="fa-solid fa-receipt"></i></button>' +
                '<button onclick="openReceipt(\''+item.id+'\')" class="text-primary" title="ดูใบเสร็จ A4"><i class="fa-solid fa-file-invoice"></i></button>' +
                '<button onclick="downloadReceiptPDF(\''+item.id+'\')" class="text-purple-600 no-print" title="บันทึก PDF"><i class="fa-solid fa-file-pdf"></i></button>' +
                '<button onclick="deleteItem(\''+item.id+'\',\'order\')" class="text-red-400" title="ลบ"><i class="fa-solid fa-trash"></i></button>' +
                '</div></div></div>';
        } else {
            html += '<div class="p-4 hover:bg-gray-50 transition bg-red-50/30">' +
                '<div class="flex justify-between items-center mb-1">' +
                '<div class="font-bold text-gray-800">'+esc(item.title)+'</div>' +
                '<div class="font-bold text-red-500">-฿'+item.amount.toLocaleString()+'</div></div>' +
                '<div class="flex justify-between items-center text-sm text-gray-500">' +
                '<div>รายจ่ายร้าน</div>' +
                '<button onclick="deleteItem(\''+item.id+'\',\'exp\')" class="text-red-400 text-lg"><i class="fa-solid fa-trash"></i></button></div></div>';
        }
    });
    list.innerHTML = html;
}

// ================================================================
//  ESCAPE HTML
// ================================================================
function esc(str){
    if(!str) return '';
    var div=document.createElement('div');
