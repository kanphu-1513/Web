            '<td style="padding:6px 8px;border-right:1px solid #999;border-bottom:1px solid #ccc;text-align:right;font-size:11px;">'+(item.price!==''&&item.price!==undefined?Number(item.price).toFixed(2):'')+'</td>'+
            '<td style="padding:6px 8px;border-bottom:1px solid #ccc;text-align:right;font-size:11px;">'+displayTotal+'</td></tr>';
