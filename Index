        function printReceipt(id) {
            const order = orders.find(o => o.id === id.toString()); if (!order) return;
            const printWindow = window.open('', '_blank'); const printDate = order.date;
            const THBText = (n) => { if(n === 0) return 'ศูนย์บาทถ้วน'; let t = "", txtNum = ["ศูนย์","หนึ่ง","สอง","สาม","สี่","ห้า","หก","เจ็ด","แปด","เก้า"]; let txtDigit = ["","สิบ","ร้อย","พัน","หมื่น","แสน","ล้าน"]; let s = n.toFixed(2).split("."); let baht = s[0], satang = s[1]; function convert(str) { let res = ""; for(let i=0; i<str.length; i++) { let d = parseInt(str[i]); let p = str.length - i - 1; if(d !== 0) { if(d === 1 && p === 0 && str.length > 1) res += "เอ็ด"; else if(d === 2 && p === 1) res += "ยี่"; else if(d === 1 && p === 1) res += ""; else res += txtNum[d]; res += txtDigit[p]; } } return res; } t += convert(baht) + "บาท"; if(satang === "00") t += "ถ้วน"; else t += convert(satang) + "สตางค์"; return t; };
            const items = getItemsArray(order); if(order.discount > 0) items.push({ name: 'ส่วนลด', qty: '', price: '', total: -order.discount });
