// ================================================================
//  5️⃣ บันทึกเป็น PDF — แก้ให้ใช้งานได้จริง
// ================================================================
function downloadReceiptPDF(id) {
    var order=orders.find(function(o){return o.id.toString()===id.toString();});
    if(!order) return;

    var overlay = document.getElementById('pdfOverlay');
    var statusText = document.getElementById('pdfStatusText');
    overlay.style.display = 'flex';
    statusText.className = 'status';
    statusText.textContent = 'กำลังโหลดแบบใบเสร็จ...';

    var html = generateReceiptHTML(order);

    // ใช้วิธี iframe สำหรับ render ก่อน แล้วค่อย export
    var iframe = document.createElement('iframe');
    iframe.style.cssText = 'position:absolute;left:-9999px;top:0;width:210mm;border:none;';
    document.body.appendChild(iframe);

    var iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
    iframeDoc.open();
    iframeDoc.write(html);
    iframeDoc.close();

    iframe.onload = function() {
        statusText.textContent = 'กำลังสร้าง PDF...';
        var bodyEl = iframeDoc.body;

        setTimeout(function() {
            try {
                var opt = {
                    margin:       [5, 5, 5, 5],
                    filename:     'ใบเสร็จ_' + order.orderNo + '.pdf',
                    image:        { type: 'jpeg', quality: 0.95 },
                    html2canvas:  { scale: 2, useCORS: true, letterRendering: true, logging: false },
                    jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
                    pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
                };

                html2pdf().set(opt).from(bodyEl).save().then(function(filename) {
                    document.body.removeChild(iframe);
                    overlay.style.display = 'none';
                    statusText.textContent = 'สร้าง PDF สำเร็จ!';
                }).catch(function(err) {
                    console.error('html2pdf error:', err);
                    document.body.removeChild(iframe);
                    statusText.className = 'status error';
                    statusText.textContent = 'สร้าง PDF ไม่สำเร็จ';
                    setTimeout(function(){ overlay.style.display = 'none'; }, 2000);
                });
            } catch(e) {
                console.error(e);
                document.body.removeChild(iframe);
                statusText.className = 'status error';
                statusText.textContent = 'เกิดข้อผิดพลาด';
                setTimeout(function(){ overlay.style.display = 'none'; }, 2000);
            }
        }, 500);
    };

    // Fallback timeout ถ้า iframe ไม่โหลด
    setTimeout(function() {
        if (document.body.contains(iframe)) {
            try { iframeDoc.close(); } catch(e) {}
            try { iframe.onload = null; iframe.onload(); } catch(e) {}
        }
    }, 8000);
}

// ================================================================
//  EXPORT CSV
// ================================================================
function exportToCSV() {
    var today=new Date().toLocaleDateString('th-TH');
    var todayOrders=orders.filter(function(o){return o.date===today;});
    if(todayOrders.length===0){Swal.fire('ไม่มีข้อมูล','ยังไม่มีรายการขายในวันนี้','info');return;}
    var csv='\uFEFF' + 'รหัสบิล,ชื่อลูกค้า,ช่องทางชำระ,ยอดรวม(บาท),วันที่\n';
    todayOrders.forEach(function(o){
        csv+='"'+o.orderNo+'","'+esc(o.name)+'","'+esc(o.payment)+'",'+o.totalPrice+',"'+o.date+'"\n';
    });
    var link=document.createElement('a');
    link.setAttribute('href','data:text/csv;charset=utf-8,'+encodeURIComponent(csv));
    link.setAttribute('download','ยอดขาย_หวานใจยายชา_'+today.replace(/\//g,'-')+'.csv');
    document.body.appendChild(link);link.click();document.body.removeChild(link);
}
